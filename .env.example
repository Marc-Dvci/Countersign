# Countersign settings. Every one of these has a working default; copy this file
# to .env only when you want to change something.

# ---------------------------------------------------------------- the model
# demo       the deterministic composer. No model is invoked, nothing is billed,
#            and the whole product works. This is what the seeded demonstration
#            runs on and what a judge sees by default.
# bedrock    the Strands agents against Amazon Bedrock.
# agentcore  the Strands agents inside a deployed Bedrock AgentCore runtime.
COUNTERSIGN_MODEL_MODE=demo
COUNTERSIGN_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
COUNTERSIGN_BEDROCK_REGION=eu-west-1
COUNTERSIGN_AGENTCORE_ARN=

# ----------------------------------------------------------------- the data
COUNTERSIGN_TENANT=kestrel
COUNTERSIGN_DATABASE_PATH=data/countersign.db
COUNTERSIGN_SESSION_PATH=data/sessions

# The date the schedule and every control period are measured from. It defaults
# to the date the seeded estate is anchored to, so the numbers on screen do not
# drift with the calendar. Set it to today when the connectors are live.
COUNTERSIGN_AS_OF=2026-09-01

# ------------------------------------------------------------- the console
COUNTERSIGN_HOST=127.0.0.1
COUNTERSIGN_PORT=8080
COUNTERSIGN_CONSOLE_USER=risk
COUNTERSIGN_CONSOLE_PASSWORD=countersign

# ------------------------------------------------------- live connectors
# Any source with credentials present switches from the seeded corpus to the
# real API. Everything else stays on the corpus, and a control cannot tell the
# difference. Read scopes only: nothing in this codebase writes to a source.
# GITHUB_ORG=
# GITHUB_TOKEN=
# JIRA_SITE=https://yourcompany.atlassian.net
# JIRA_EMAIL=
# JIRA_TOKEN=
# OKTA_DOMAIN=https://yourcompany.okta.com
# OKTA_TOKEN=
