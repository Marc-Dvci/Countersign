# Production settings for the public console. Copy to .env.production and
# replace every CHANGE_ME. chmod 600 it.

# The hostname Caddy will obtain a certificate for. An sslip.io name resolves
# to the IP encoded in it, so a host with a static IP needs no DNS record:
#   1-2-3-4.sslip.io  ->  1.2.3.4
COUNTERSIGN_DOMAIN=CHANGE_ME.sslip.io

COUNTERSIGN_HOST=0.0.0.0
COUNTERSIGN_PORT=8080
COUNTERSIGN_DATABASE_PATH=/app/data/countersign.db
COUNTERSIGN_SESSION_PATH=/app/data/strands-sessions

# Reading the console needs no account. These credentials gate the three
# transactions that carry authority. On a public evaluation host they are
# published in the README on purpose.
COUNTERSIGN_CONSOLE_USER=risk
COUNTERSIGN_CONSOLE_PASSWORD=CHANGE_ME

# demo runs the deterministic composer. Switch to bedrock or agentcore once the
# account has model access; agentcore also needs the ARN below, and
# `countersign runtime` will tell you whether it answers before you switch.
COUNTERSIGN_MODEL_MODE=demo
COUNTERSIGN_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
COUNTERSIGN_BEDROCK_REGION=eu-west-1
COUNTERSIGN_AGENTCORE_ARN=

# Leave this off in production. It lets a source without credentials fall back
# to the seeded corpus while another source is live, which is a control joining
# real evidence to invented evidence.
COUNTERSIGN_ALLOW_SOURCE_MIXING=false

# The seeded estates are anchored to this date, so the figures on screen do not
# drift with the calendar. Set it to today only when the connectors are live.
COUNTERSIGN_AS_OF=2026-09-01
COUNTERSIGN_TENANT=kestrel
